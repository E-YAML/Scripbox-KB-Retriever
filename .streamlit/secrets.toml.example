# .streamlit/secrets.toml.example
# ─────────────────────────────────────────────────────────────
# Copy this file to .streamlit/secrets.toml and fill in your keys.
# NEVER commit secrets.toml to version control.
#
# The app uses Groq as primary LLM and Gemini as automatic fallback.
# Add at least one key. Both = maximum resilience.
#
# Groq  (primary — fast streaming):  https://console.groq.com → API Keys
# Gemini (fallback — rate-limit resilience): https://aistudio.google.com/apikey
# ─────────────────────────────────────────────────────────────

GROQ_API_KEY   = "gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GEMINI_API_KEY = "AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# GROQ_MODEL     = "llama-3.3-70b-versatile"
# GEMINI_MODEL   = "gemini-2.5-flash"
